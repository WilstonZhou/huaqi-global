{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/hk", "destination": "/country/hk", "permanent": true },
    { "source": "/us", "destination": "/country/us", "permanent": true },
    { "source": "/cross-border-compliance", "destination": "/knowledge/cross-border-compliance", "permanent": true },
    { "source": "/overseas-bank-account-guide", "destination": "/knowledge/overseas-bank-account-guide", "permanent": true },
    { "source": "/cayman-vs-bvi", "destination": "/knowledge/cayman-vs-bvi", "permanent": true },
    { "source": "/hk-vs-sg-company", "destination": "/knowledge/hk-vs-sg-company", "permanent": true },
    { "source": "/registration-cost-comparison", "destination": "/knowledge/registration-cost-comparison", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/singapore-company-registration", "destination": "/country/sg", "permanent": true },
    { "source": "/en/hong-kong-company-registration", "destination": "/country/hk", "permanent": true },
    { "source": "/en/us-company-registration", "destination": "/country/us", "permanent": true },
    { "source": "/en/dubai-company-registration", "destination": "/country/ae", "permanent": true },
    { "source": "/en/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
